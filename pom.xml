<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Standalone parent for qits-ci-runner-daemon, deliberately the same shape as qits-ci-daemon's
         root, which is itself qits-workspace-daemon's: the eu.wohlben:qits coordinates a child's
         <parent> points at (../pom.xml), the quarkus-bom import, and the compiler/surefire pins —
         and nothing else. A clone of this repo alone must `./mvnw verify` green.

         The version is 1.0.0-SNAPSHOT until the first release stamps it, exactly as qits-ci-daemon's
         was before its first; the release flow rewrites every <version> here to the tag it cuts.

         The reactor holds the wire contract and the application that speaks it. Both exist; a
         module listed here that did not would break the clone-alone rule this file is here to
         keep. -->
    <groupId>eu.wohlben</groupId>
    <artifactId>qits</artifactId>
    <version>2026.1009.173435</version>
    <packaging>pom</packaging>

    <modules>
        <module>ci-runner-protocol</module>
        <module>ci-runner</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.34.6</quarkus.platform.version>

        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.4</surefire-plugin.version>
        <!-- qits-runner-javalib, the ONE version both of its jars are taken at: qits-runner-protocol
             (the shared health report wire, HealthWire) in ci-runner-protocol, and
             qits-runner-toolkit (the health-check machinery, and nothing else yet — moving the
             runner onto RunnerRuntime is qits-772) in ci-runner. -->
        <qits.runner.version>2026.1009.172202</qits.runner.version>

        <!-- Where the platform publishes it. Overridden by CI (-Dqits.maven.repository.url), derived
             from QITS_DOMAIN; the default below is the public host. -->
        <qits.maven.repository.url>https://registry.qits.wohlben.eu/artifacts/maven/maven</qits.maven.repository.url>
    </properties>

    <!-- The platform's own Maven repository: qits-runner-protocol, qits-runner-toolkit and the
         qits-containers-driver beneath it live only here. The id has to stay `qits-maven` — it is
         what the settings file's exact-id mirror matches (Maven blocks external http:// repositories
         otherwise) and what a locally cached copy is recorded under. -->
    <repositories>
        <repository>
            <id>qits-maven</id>
            <url>${qits.maven.repository.url}</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!-- Supplies the managed versions the children leave unversioned: junit-jupiter for
                 both modules, quarkus-arc/quarkus-vertx for the application. The protocol module
                 has no main-scope dependency at all and is not allowed to grow one. -->
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- The wire-contract module under its PUBLISHED coordinate — `eu.wohlben.qits:
                 qits-ci-runner-protocol`, not this reactor's group and not the directory name — so
                 `-pl ci-runner -am` resolves it from the reactor beside it rather than from a
                 registry. qits-ci-daemon's root pom carries the same entry for the same reason. -->
            <dependency>
                <groupId>eu.wohlben.qits</groupId>
                <artifactId>qits-ci-runner-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.wohlben.qits</groupId>
                <artifactId>qits-runner-protocol</artifactId>
                <version>${qits.runner.version}</version>
            </dependency>
            <dependency>
                <groupId>eu.wohlben.qits</groupId>
                <artifactId>qits-runner-toolkit</artifactId>
                <version>${qits.runner.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>${quarkus.platform.group-id}</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
